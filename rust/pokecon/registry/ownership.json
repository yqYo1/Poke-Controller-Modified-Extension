        "EvaluationTransaction",
        "TransactionError"
      ],
      "source_files": [
        "rust/pokecon/src/dynamic/transaction.rs"
      ]
    },
    {
      "id": "dynamic_host",
      "owns": [
        "stage→commit、callback／option／command generation"
      ],
      "owner_symbols": [
