{
  "schema_version": 1,
  "modules": [
    {
      "id": "entrypoint",
      "owns": [
        "composition、startup／shutdown順、service接続、router合成"
      ],
      "owner_symbols": [
        "run_cli",
        "MainError"
      ],
      "source_files": [
        "rust/pokecon/src/entrypoint.rs",
        "rust/pokecon/src/lib.rs"
      ]
    },
    {
      "id": "production",
      "owns": [
        "composition、startup／shutdown順、service接続、router合成"
      ],
      "owner_symbols": [
        "ProductionRuntime"
      ],
      "source_files": [
