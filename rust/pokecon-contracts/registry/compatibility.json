      "script_roots": [
        "SerialController/Commands/PythonCommands",
        "SerialController/Commands/McuCommands"
      ],
      "public_import_roots": ["SerialController/Commands"],
      "expectations": {
        "source_mutation": "forbidden",
        "imports": "all_resolve",
        "class_discovery": "all_candidates_preserve_order",
