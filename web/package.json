{
  "name": "pokecon-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "dev": "bun --bun ./node_modules/vite/bin/vite.js",
    "build": "bun --bun ./node_modules/vite/bin/vite.js build",
    "preview": "bun --bun ./node_modules/vite/bin/vite.js preview",
    "lint": "bun --bun ./node_modules/@sveltejs/kit/svelte-kit.js sync && bun --bun ./node_modules/eslint/bin/eslint.js .",
    "svelte-check": "bun --bun ./node_modules/@sveltejs/kit/svelte-kit.js sync && bun --bun ./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
    "test": "bun --bun ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "20.19.43",
    "eslint": "10.7.0",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "svelte": "5.56.7",
    "svelte-check": "4.7.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
