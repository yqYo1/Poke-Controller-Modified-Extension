      "source_files": [
        "rust/pokecon/src/contracts/model.rs",
        "rust/pokecon/src/contracts/settings_artifacts.rs"
      ]
    },
    {
      "id": "registry",
      "owns": [
        "canonical settings／protocol／compatibility inputと生成"
      ],
      "owner_symbols": [],
      "source_files": [
        "rust/pokecon/registry/foundation.json",
        "rust/pokecon/registry/generation.json",
        "rust/pokecon/registry/compatibility.json"
      ],
      "note": "registry/ JSON inputsはRust symbolを持たない正準入力であるためowner symbolを主張しない。schema_versionキーで版を固定する。"
    },
    {
      "id": "runtime_shutdown",
      "owns": [
        "first-writer-wins reason、process cancellation"
      ],
      "owner_symbols": [
        "ShutdownCoordinator"
      ],
      "source_files": [
        "rust/pokecon/src/runtime/shutdown.rs",
        "rust/pokecon/src/runtime/mod.rs"
      ]
    },
    {
      "id": "frontend",
      "owns": [
        "server projectionの表示と公開contract利用"
      ],
      "owner_symbols": [],
      "source_files": [
        "web/src/lib/api.ts",
        "web/src/lib/camera-selector.ts"
      ],
      "note": "frontendはRust crate外の表示層でありRust owner symbolを持たない。列挙sourceは公開contractを利用する側の実在fileである。"
    },
    {
      "id": "generated_client",
      "owns": [
        "server projectionの表示と公開contract利用"
      ],
      "owner_symbols": [],
      "source_files": [
        "web/src/lib/api/openapi.ts"
      ],
      "note": "生成clientはopenapi-typescript生成物でありRust owner symbolを持たない。直接編集せず再生成する。"
    }
  ]
}
