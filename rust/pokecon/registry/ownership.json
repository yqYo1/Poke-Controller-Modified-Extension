      ],
      "owner_symbols": [
        "DynamicWorkerRuntime",
        "ScriptWorkerRuntime"
      ],
      "source_files": [
        "rust/pokecon/src/worker_binary/mod.rs",
        "rust/pokecon/src/worker_binary/dynamic/dispatch.rs",
        "rust/pokecon/src/worker_binary/script/runtime.rs"
      ]
