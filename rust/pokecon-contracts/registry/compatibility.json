      }
    }
  ],
  "rolling_candidates": {
    "storage": "compatibility/candidates.json",
    "promotion_history": "compatibility/promotions.jsonl",
    "append_only": true,
    "requires_full_three_repository_chain": true,
    "requires_runtime_tests": true,
    "requires_api_surface_comparison": true,
    "breaking_changes": [
      "public_api_removed",
      "public_api_renamed",
      "argument_removed",
      "optional_argument_made_required",
      "accepted_input_narrowed",
      "default_behavior_broken",
      "observable_behavior_broken"
    ],
    "non_promotable_results": [
      "breaking",
      "environment_dependent_failure",
      "unverified"
    ]
  },
  "inventory": {
    "fixed_manifest": "compatibility/fixed-manifest.json",
    "fixed_results": "compatibility/fixed-results.json",
    "rolling_results": "compatibility/results/<candidate-id>.json",
    "content_hash": "sha256",
    "extract": "nix run .#compatibility-inventory",
    "execute": "nix run .#compatibility",
    "verify": "nix run .#compatibility -- --check",
    "promotion_check": "python -m scripts.compatibility_promote --check",
    "rolling_evaluate": "nix run .#compatibility-roll",
    "rolling_monitor": ".github/workflows/compatibility-roll.yml"
  }
}
