        "StartupDynamicHost"
      ],
      "source_files": [
        "rust/pokecon/src/dynamic/host.rs",
        "rust/pokecon/src/dynamic_host.rs"
      ]
    },
    {
      "id": "settings",
      "owns": [
        "canonical settings／protocol／compatibility inputと生成"
